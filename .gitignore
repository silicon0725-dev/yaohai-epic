# Godot 4 生成目录（导入缓存、全局类缓存等）
.godot/

# 翻译与临时文件
*.translation
*.tmp

# 运行时截图（debug 检查输出，不入库）
debug/*.png
debug/*.png.import
debug/*.jpg
debug/*.jpg.import

# 临时截图/裁剪工作目录（视觉验证中间产物）
.tmp_shots/
debug/_crops/
debug/tmp_v5/
debug/treev2_crops/
debug/_zoom_tmp/

# 本地 Conquest 材质暂存（许可禁止再分发，绝不入库；见 assets/textures/CREDITS.md）
assets/textures/conquest_local/

# node_modules（blockbench-mcp vendor 的 bun 二进制在此，npm install 可恢复）
node_modules/

# 本地工具产物与会话目录
.mimosa/
.zcode/

# 调试运行日志（脚本本身入库，输出不入）
debug/*.log
debug/archive/*.log

# 第三方专有许可素材（禁止再分发，同 conquest_local 先例）
EmacEArtStylizedGrass/

# Godot/工具写入的临时文件（~ 前缀，如 addons 构建的中间 dll）
~*

# 一次性调试脚本与 Python 产物（tmp_* 先例见 tmp_v5；pycache 防外带）
debug/tmp_*
__pycache__/
*.pyc
debug/archive/*.png
